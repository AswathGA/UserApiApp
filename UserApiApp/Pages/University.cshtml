@page
@model UserApiApp.Pages.UniversityModel
@{
    ViewData["Title"] = "Lectures";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        body {
            font-family: 'Arial', sans-serif;
            background-color: #E6E6FA; /* Light purple background for body */
            margin: 0;
            padding: 0;
        }

        header {
            background-color: #800080; /* Dark purple header */
            color: #800080;
            padding: 20px;
            text-align: center;
        }

            header h1 {
                margin: 0;
            }

        .user-cards-container {
            display: flex;
            flex-wrap: wrap;
            gap: 20px; /* Adjust the gap between cards */
            justify-content: space-around; /* Distribute space between cards */
            padding: 20px;
            background-color: #E6E6FA; /* Light purple background for lecture section */
            border-radius: 8px;
        }

        .user-card {
            flex: 1 1 calc(45% - 20px); /* Adjust card width */
            max-width: calc(45% - 20px); /* Ensure max width for each card */
            border: 1px solid #ddd;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            background-color: #fff;
            overflow: hidden; /* Ensure contents don't overflow */
            display: flex; /* Display children (image and content) in a row */
            flex-direction: column; /* Align content vertically */
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .user-card:hover {
                transform: translateY(-10px);
                box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
            }

            .user-card img {
                width: 100%;
                height: auto;
                border-radius: 8px 8px 0 0; /* Rounded corners for the top */
                transition: opacity 0.3s ease;
            }

            .user-card:hover img {
                opacity: 0.9;
            }

        .user-card-content {
            padding: 16px;
            text-align: left;
        }

            .user-card-content h3 {
                margin: 0 0 10px;
                color: #2c3e50;
            }

            .user-card-content p {
                margin: 5px 0;
                color: #555;
            }

        .user-card-links {
            padding: 16px;
            border-top: 1px solid #ddd;
            background-color: #f9f9f9;
        }

            .user-card-links p {
                margin: 8px 0;
                color: #555;
            }

            .user-card-links a {
                color: #007bff;
                text-decoration: none;
                transition: color 0.3s ease;
            }

                .user-card-links a:hover {
                    color: #0056b3;
                }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light  box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/University">Lectures</a>
                <form method="get" asp-page="/Login">
                    <button type="submit" class="btn btn-primary login-button ml-auto">Login</button>
                </form>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            <div class="user-cards-container">
                @if (Model.Users == null)
                {
                    <p>Loading...</p>
                }
                else
                {
                    @foreach (var user in Model.Users)
                    {
                        @await Html.PartialAsync("_UserCard", user)
                    }
                }
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
</body>
</html>
